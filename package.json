{
  "name": "dsh-netease-music",
  "version": "0.3.0",
  "description": "NetEase Cloud Music player for DeepSeek Harness: mini bar, liquid-glass card, vinyl view, search, lyrics, auto sign-in with the local NetEase client, client sync. Player only, no background effects.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "netease",
    "music",
    "player",
    "lyrics"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzy040919-ship-it/dsh-netease-music.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
